# -*- mode: python ; coding: utf-8 -*-
"""Windows onedir spec: ``console=False``, the icon, and the WebView2 backend.

The launcher is ``StemForge.exe``; the frozen
payload lives in ``_internal\\`` and ``packaging\\windows\\build.ps1`` adds
``vendor\\`` and the licence tree beside it. The Separation worker's torch/Demucs
imports happen inside ``run()``, so they are listed as hidden imports;
``torch/test`` and ``torch/bin`` are trimmed (162 MB measured).

The version resource is generated by ``packaging/windows/version_info.py`` from
``stemforge.__version__`` and passed through ``STEMFORGE_VERSION_FILE`` so the
build cannot silently ship PyInstaller's default file properties. The legacy
web engine is excluded: the app's startup preflight exits 5 when WebView2 is
missing, so it never falls back to a blank page.
"""

import os
from pathlib import Path

from PyInstaller.utils.hooks import collect_data_files, collect_submodules

ROOT = Path(SPECPATH).resolve().parents[1]
SRC = ROOT / "src" / "stemforge"

_version_file = Path(
    os.environ.get(
        "STEMFORGE_VERSION_FILE",
        str(ROOT / "packaging" / "windows" / "version_info.txt"),
    )
)
if not _version_file.is_file():
    raise SystemExit(
        "stemforge_windows.spec: version resource is missing; "
        "run packaging/windows/build.ps1 or set STEMFORGE_VERSION_FILE"
    )

datas = [
    (str(SRC / "assets"), "assets"),
    (str(SRC / "models" / "models.lock.json"), "models"),
    # Catalogs load relative to stemforge/i18n/__init__.py, which PyInstaller
    # keeps at that path under _internal/.
    (str(SRC / "i18n" / "catalogs"), "stemforge/i18n/catalogs"),
    # The frozen preflight verifies vendor/ against this lock.
    (str(ROOT / "packaging" / "vendor.lock.json"), "."),
    *collect_data_files("nicegui"),
    # demucs/remote/files.txt is read by the legacy repo fallback; the HF path
    # used by the worker needs no network data but the package is tiny.
    *collect_data_files("demucs"),
]

hiddenimports = [
    # smoke.py imports these by name so the heavy stack stays off module scope.
    "webview",
    "webview.platforms.edgechromium",
    "webview.platforms.winforms",
    "stemforge.ui.page",
    # The worker imports torch/Demucs inside run(); a call-time import is
    # invisible to static analysis, and omitting them measured a 150 MB bundle.
    "torch",
    "demucs.api",
    "demucs.apply",
    "demucs.audio",
    "demucs.hdemucs",
    "demucs.hf",
    "demucs.htdemucs",
    "demucs.pretrained",
    "demucs.repo",
    "demucs.spec",
    "demucs.states",
    "demucs.transformer",
    "demucs.utils",
    "demucs.wiener",
    "stemforge.workers.separation",
    # The pytest/User-simulation helpers pull pytest and mypy into the
    # payload; the shipped app never imports them.
    *(name for name in collect_submodules("nicegui") if not name.startswith("nicegui.testing")),
]

a = Analysis(
    [str(SRC / "__main__.py")],
    pathex=[str(ROOT / "src")],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[str(ROOT / "packaging" / "pyinstaller" / "runtime-hooks" / "rthook_stemforge_env.py")],
    # mypy is a pydantic hook side effect and is only needed at type-check time.
    # webview.platforms.mshtml is the legacy engine; the app has no fallback.
    excludes=[
        "tkinter",
        "mypy",
        "pydantic.mypy",
        "pydantic.v1.mypy",
        "torchaudio",
        "webview.platforms.mshtml",
    ],
    noarchive=False,
    optimize=0,
)

# An inference-only bundle does not need torch's test
# suite or its command-line helpers (~162 MB measured). ``import torch`` refuses
# to load unless torch_shm_manager exists, so that one file stays.
_TORCH_KEEP_BIN = {"torch_shm_manager", "torch_shm_manager.exe"}


def _keep(entry):
    destination = entry[0].replace("\\", "/")
    if destination in {"torch/test", "torch/bin"}:
        return False
    if destination.startswith(("torch/test/", "torch/bin/")):
        return destination.rsplit("/", 1)[-1] in _TORCH_KEEP_BIN
    return True


a.datas = [entry for entry in a.datas if _keep(entry)]
a.binaries = [entry for entry in a.binaries if _keep(entry)]

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="StemForge",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=str(SRC / "assets" / "stemforge.ico"),
    version=str(_version_file),
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="StemForge",
)
