    "rubberband": {
      "version": "4.0.0",
      "version_flag": "--version",
      "license": "GPL-2.0-or-later",
      "license_texts": [
        "COPYING"
      ],
      "provenance": {
        "project": "Rubber Band Library",
        "homepage": "https://breakfastquay.com/rubberband/",
        "source_repository": "https://github.com/breakfastquay/rubberband",
        "tag": "v4.0.0",
        "commit": "1d95888bec3ae0a17c0c4af791810d5a63f6bc35",
        "build": "Meson release build, builtin FFT/resampler, static librubberband, CLI only, no LV2/VST/LADSPA/Vamp/JNI."
      },
      "targets": {
        "linux-x86_64": {
          "kind": "built",
          "source": {
            "url": "https://github.com/breakfastquay/rubberband/archive/refs/tags/v4.0.0.tar.gz",
            "filename": "rubberband-4.0.0.tar.gz",
            "size": 290305,
            "sha256": "24300f48a8014b7c863b573a9647e61b1b19b37875e2cdd92005e64c6424d266"
          },
          "build": {
            "system": "meson",
            "archive_format": "tar.gz",
            "configure": [
              "meson",
              "setup",
              "build",
              "<source>",
              "--buildtype=release",
              "--default-library=static",
              "-Dfft=builtin",
              "-Dresampler=builtin",
              "-Dvamp=disabled",
              "-Dlv2=disabled",
              "-Dladspa=disabled",
              "-Djni=disabled",
              "-Dcmdline=enabled",
              "-Dtests=disabled",
              "-Dcpp_link_args=-Wl,-rpath,$ORIGIN",
              "-Dc_link_args=-Wl,-rpath,$ORIGIN"
            ],
            "post_build": [
              "ninja -C build",
              "strip --strip-unneeded build/rubberband",
              "patchelf --set-rpath $ORIGIN vendor/rubberband/rubberband"
            ],
            "notes": "Built after libsndfile 1.2.2, with PKG_CONFIG_PATH pointing at the libsndfile prefix. The CLI statically contains librubberband and dynamically links only libsndfile.so.1, libstdc++, libm, libgcc_s, and glibc."
          },
          "install": [
            {
              "from": "build/rubberband",
              "to": "rubberband/rubberband",
              "executable": true,
              "sha256": null
            }
          ]
        },
        "windows-x64": {
          "kind": "built",
          "source": {
            "url": "https://github.com/breakfastquay/rubberband/archive/refs/tags/v4.0.0.tar.gz",
            "filename": "rubberband-4.0.0.tar.gz",
            "size": 290305,
            "sha256": "24300f48a8014b7c863b573a9647e61b1b19b37875e2cdd92005e64c6424d266"
          },
          "build": {
            "system": "meson-msvc",
            "archive_format": "tar.gz",
            "configure": [
              "meson",
              "setup",
              "build",
              "<source>",
              "--buildtype=release",
              "--default-library=static",
              "-Dfft=builtin",
              "-Dresampler=builtin",
              "-Dvamp=disabled",
              "-Dlv2=disabled",
              "-Dladspa=disabled",
              "-Djni=disabled",
              "-Dcmdline=enabled",
              "-Dtests=disabled",
              "-Dextra_lib_dirs=<libsndfile-build>",
              "-Dextra_include_dirs=<libsndfile-source>/include"
            ],
            "post_build": [
              "meson compile -C build",
              "copy build/rubberband.exe and the libsndfile sndfile.dll beside it"
            ],
            "notes": "Ticket 10 §8 builds this with MSVC on windows-2022 after libsndfile 1.2.2. No public prebuilt Rubber Band archive is named by the decision record; scripts/vendor-fetch.ps1 therefore accepts a prebuilt pinned directory with -RubberBandPrebuilt when Meson/MSVC are unavailable, and verifies rubberband.exe --version 4.0.0 plus the co-located sndfile.dll."
          },
          "install": [
            {
              "from": "build/rubberband.exe",
              "to": "rubberband/rubberband.exe",
              "executable": true,
              "sha256": null
            }
          ]
        }
      }
    },
    "libsndfile": {
      "version": "1.2.2",
      "version_flag": null,
      "license": "LGPL-2.1-or-later",
      "license_texts": [
        "COPYING"
      ],
      "provenance": {
        "project": "libsndfile",
        "homepage": "https://libsndfile.github.io/libsndfile/",
        "source_repository": "https://github.com/libsndfile/libsndfile",
        "tag": "1.2.2",
        "build": "CMake release build, shared library, WAV-only (external codecs and MPEG off), programs/examples/tests off, dynamic linking preserves the LGPL relink right."
      },
      "targets": {
        "linux-x86_64": {
          "kind": "built",
          "source": {
            "url": "https://github.com/libsndfile/libsndfile/releases/download/1.2.2/libsndfile-1.2.2.tar.xz",
            "filename": "libsndfile-1.2.2.tar.xz",
            "size": 730760,
            "sha256": "3799ca9924d3125038880367bf1468e53a1b7e3686a934f098b7e1d286cdb80e"
          },
          "build": {
            "system": "cmake",
            "archive_format": "tar.xz",
            "configure": [
              "cmake",
              "-S",
              "<source>",
              "-B",
              "build",
              "-DCMAKE_BUILD_TYPE=Release",
              "-DCMAKE_INSTALL_PREFIX=<prefix>",
              "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
              "-DBUILD_SHARED_LIBS=ON",
              "-DBUILD_PROGRAMS=OFF",
              "-DBUILD_EXAMPLES=OFF",
              "-DBUILD_TESTING=OFF",
              "-DENABLE_EXTERNAL_LIBS=OFF",
              "-DENABLE_MPEG=OFF",
              "-DENABLE_CPACK=OFF",
              "-DINSTALL_PKGCONFIG_MODULE=ON",
              "-DINSTALL_MANPAGES=OFF"
            ],
            "post_build": [
              "cmake --build build --parallel",
              "cmake --install build",
              "strip --strip-unneeded libsndfile.so.1"
            ],
            "notes": "The versioned libsndfile.so.1.0.37 is copied to vendor/rubberband/libsndfile.so.1 so the Rubber Band CLI's $ORIGIN rpath finds it. The file remains separately replaceable for the LGPL relink right."
          },
          "install": [
            {
              "from": "libsndfile.so.1",
              "to": "rubberband/libsndfile.so.1",
              "executable": false,
              "sha256": null
            }
          ]
        },
        "windows-x64": {
          "kind": "built",
          "source": {
            "url": "https://github.com/libsndfile/libsndfile/releases/download/1.2.2/libsndfile-1.2.2.tar.xz",
            "filename": "libsndfile-1.2.2.tar.xz",
            "size": 730760,
            "sha256": "3799ca9924d3125038880367bf1468e53a1b7e3686a934f098b7e1d286cdb80e"
          },
          "build": {
            "system": "cmake-msvc",
            "archive_format": "tar.xz",
            "configure": [
              "cmake",
              "-S",
              "<source>",
              "-B",
              "build",
              "-A",
              "x64",
              "-DCMAKE_BUILD_TYPE=Release",
              "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
              "-DBUILD_SHARED_LIBS=ON",
              "-DBUILD_PROGRAMS=OFF",
              "-DBUILD_EXAMPLES=OFF",
              "-DBUILD_TESTING=OFF",
              "-DENABLE_EXTERNAL_LIBS=OFF",
              "-DENABLE_MPEG=OFF",
              "-DENABLE_CPACK=OFF",
              "-DINSTALL_PKGCONFIG_MODULE=ON",
              "-DINSTALL_MANPAGES=OFF"
            ],
            "post_build": [
              "cmake --build build --config Release --parallel",
              "copy the Release sndfile.dll beside rubberband.exe"
            ],
            "notes": "Windows resolves sndfile.dll from the executable's own directory, so it is co-located with rubberband.exe. scripts/vendor-fetch.ps1 accepts the pair from -RubberBandPrebuilt when the MSVC build is unavailable."
          },
          "install": [
            {
              "from": "sndfile.dll",
              "to": "rubberband/sndfile.dll",
              "executable": false,
              "sha256": null
            }
          ]
        }
      }
    }
